{
  "manifest_version": 3,
  "name": "푸른 리멤버 연결",
  "version": "1.0.0",
  "description": "리멤버에서 새로 받거나 고친 명함을 30분마다 푸른사진첩·기업정보함으로 옮깁니다 (푸른노무법인 내부용).",
  "permissions": ["alarms", "tabs"],
  "host_permissions": [
    "https://card.rememberapp.co.kr/*",
    "https://remember-cdn.rememberapp.co.kr/*",
    "https://nabaho.github.io/pureunall/remember-intake.html*"
  ],
  "action": { "default_title": "푸른 리멤버 연결 — 눌러서 지금 돌리기" },
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    {
      "matches": ["https://card.rememberapp.co.kr/*"],
      "js": ["hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://card.rememberapp.co.kr/*"],
      "js": ["rem-relay.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://nabaho.github.io/pureunall/remember-intake.html*"],
      "js": ["intake-relay.js"],
      "run_at": "document_idle"
    }
  ]
}
