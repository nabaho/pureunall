<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 지난 문자 가져오기 (대표 지시 2026-08-29).
         알림은 지나가면 사라져서, 앱을 깔기 «전»에 온 문자는 영영 못 본다.
         이 권한은 «대표가 단추를 누를 때만» 쓴다 — 평소에는 알림만 엿듣는다.
         읽은 문자는 걸러서 다리로 넘기고 앱에는 남기지 않는다. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- 절전 예외 (2026-08-30).
         15분 훑기는 WorkManager 로 도는데, 절전이 켜져 있으면 안드로이드가
         그것을 «무기한» 미룬다. 실제로 20:42 에 연결한 폰이 두 시간 가까이
         한 번도 안 훑었다 — 앱도 권한도 멀쩡했는데 그랬다.
         이 권한이 있어야 「절전 예외로 두기」를 «한 번 눌러» 끝낼 수 있다.
         없으면 사람이 설정 앱을 헤매야 하고, 그러면 아무도 안 한다.
         ⚠ 사내 배포용 앱이다(플레이스토어에 올리지 않는다). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 방문 사업장 «사전 안내 문자» 보내기 (2026-10-15, 대표 지시 「돈 안 내고 내 폰에서」).
         ⚠ 앱을 열어 「방문 안내 문자 보내기 허용」을 «눌렀을 때만» 묻는다. 누르지 않으면 묻지 않고,
           권한이 없으면 서버도 이 폰에 문자 일을 주지 않는다.
         ⚠ 서버가 준 «열쇠·휴대폰 번호·문구»만 보낸다(VisitSmsSender). 앱이 스스로 문자를 지어 보내지 않는다. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="푸른 하나문자 연결"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".HanaNotificationListener"
            android:exported="true"
            android:label="푸른 하나 거래문자 연결"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
