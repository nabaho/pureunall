{
  "mcpServers": {
    "hrmcp": {
      "type": "http",
      "url": "https://ncs-mcp-bridge-mini2.vercel.app/api/mcp"
    },
    "korean-law": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "korean-law-mcp"],
      "env": { "LAW_OC": "${LAW_OC:-}" }
    },
    "kordoc": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "kordoc@4.12.0", "mcp"],
      "env": { "KORDOC_OFFLINE": "1", "KORDOC_ROOT": "${KORDOC_ROOT:-}" }
    }
  }
}
